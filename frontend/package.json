{
  "name": "endosoflow-employee-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript ../backend/api/openapi.yaml --default-non-nullable=false -o src/shared/api/schema.d.ts",
    "api:types:check": "openapi-typescript ../backend/api/openapi.yaml --default-non-nullable=false -o /tmp/schema.check.d.ts && diff -q /tmp/schema.check.d.ts src/shared/api/schema.d.ts",
    "test:integration": "INTEGRATION_API=1 VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:8080/api/v1} INTEGRATION_PASSWORD=${INTEGRATION_PASSWORD:-Demo-12345!} INTEGRATION_MANAGER=${INTEGRATION_MANAGER:-DNI:40123002} INTEGRATION_ADMIN=${INTEGRATION_ADMIN:-DNI:40123001} INTEGRATION_ADVISOR=${INTEGRATION_ADVISOR:-DNI:40123003} vitest run integration"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
