# Where the API lives. "/api/v1" works when a dev proxy or a Render rewrite rule makes it same-origin
# (which keeps the refresh cookie first-party). See ../../docs/DEPLOY.md.
VITE_API_BASE_URL=/api/v1

# Vite proxies /api to this Go server during local development.
VITE_API_PROXY_TARGET=http://localhost:8080
