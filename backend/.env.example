# ---- Application and environment -------------------------------------------------

# Database connection URLs
DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_dev
TEST_DATABASE_URL=postgres://username:password@localhost:5432/endosoflow_test

# Runtime environment and HTTP server
ENV=local
HTTP_ADDR=:8080

# Logging configuration
LOG_LEVEL=debug
LOG_FORMAT=text

# JWT signing secret (generate with: openssl rand -base64 48)
JWT_SECRET=dev-only-secret-change-me-at-least-32-characters-long

# Frontend base URL (used in account activation and password reset links)
APP_BASE_URL=http://localhost:5173

# ---- Codart API -------------------------------------------------------------------

# DNI and RUC name lookup
CODART_TOKEN=
CODART_BASE_URL=https://api-codart.cgrt.org

# ---- Cloudflare R2 object storage -------------------------------------------------

# Shared account configuration
R2_ACCOUNT_ID=

# Catalog images (PUBLIC bucket)
R2_CATALOG_BUCKET=endosoflow-catalog-images
R2_CATALOG_ACCESS_KEY_ID=
R2_CATALOG_SECRET_ACCESS_KEY=
R2_CATALOG_PUBLIC_BASE_URL=

# Sale documents (PRIVATE bucket)
R2_DOCUMENTS_BUCKET=endosoflow-sale-documents
R2_DOCUMENTS_ACCESS_KEY_ID=
R2_DOCUMENTS_SECRET_ACCESS_KEY=

# Employee avatars (PRIVATE bucket)
R2_AVATARS_BUCKET=endosoflow-employee-avatars
R2_AVATARS_ACCESS_KEY_ID=
R2_AVATARS_SECRET_ACCESS_KEY=
