{
  "name": "endosoflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EndosoFlow frontends: the main web app, the customer portal, and the packages they share.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev -w @endosoflow/web",
    "dev:portal": "npm run dev -w @endosoflow/portal",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build -w @endosoflow/web",
    "build:portal": "npm run build -w @endosoflow/portal",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{apps,packages}/*/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"{apps,packages}/*/src/**/*.{ts,tsx,css}\"",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "api:types": "npm run api:types -w @endosoflow/api",
    "api:types:check": "npm run api:types:check -w @endosoflow/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.0.1",
    "vitest": "^5.0.5"
  }
}
