{
  "name": "@endosoflow/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EndosoFlow main web app: sales, customers, catalog and team management.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION_API=1 VITE_API_BASE_URL=${VITE_API_BASE_URL:-http://127.0.0.1:8080/api/v1} INTEGRATION_PASSWORD=${INTEGRATION_PASSWORD:-Demo-12345!} INTEGRATION_MANAGER=${INTEGRATION_MANAGER:-DNI:40123002} INTEGRATION_ADMIN=${INTEGRATION_ADMIN:-DNI:40123001} INTEGRATION_ADVISOR=${INTEGRATION_ADVISOR:-DNI:40123003} vitest run integration"
  },
  "dependencies": {
    "@endosoflow/api": "*",
    "@endosoflow/ui": "*",
    "@tanstack/react-query": "^5.105.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4"
  }
}
